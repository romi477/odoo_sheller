{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "odoo-sheller",
  "version": "1.6.0",
  "identifier": "com.odoo-sheller.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "sh ../packaging/freeze.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "odoo-sheller",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#04030e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "A macOS window around the odoo-sheller daemon",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    },
    "resources": {
      "../../packaging/dist/odoo-sheller": "odoo-sheller",
      "../../packaging/dist/odoo-sheller-mcp": "odoo-sheller-mcp"
    }
  }
}
